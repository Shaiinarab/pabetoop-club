# ─────────────────────────────────────────────────────────────────────────────
# Pabetoop Club — runtime configuration
#
# Copy to `.env` for local Docker Compose use. Never commit the real `.env`.
#
# Every organisational name this platform renders comes from the SITE_* block
# below. Nothing is hard-coded, so a fork is re-branded by editing these six
# values and nothing else — no Go changes, no template edits.
# ─────────────────────────────────────────────────────────────────────────────

# ── Brand / white-label identity ─────────────────────────────────────────────
# Latin name used in manifests, receipts and logs.
SITE_NAME=Pabetoop Club
# Persian display name shown throughout the UI.
SITE_NAME_FA=باشگاه پابهتوپ
# Single-glyph monogram rendered in the header badge.
SITE_SHORT_FA=پ
# Discipline noun phrase; set empty to render the bare name.
SITE_DISCIPLINE_FA=مدرسه فوتبال
# City shown in the landing-page strapline; set empty to omit it entirely.
SITE_CITY_FA=
# Landing-page strapline.
SITE_TAGLINE_FA=مدیریت روشن، خانوادهٔ آسوده

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8090
# Set to 1 only for a local demo. Creates 180 fictitious players and example
# accounts. Never combine with real member data.
SEED_DEMO=0

# ── Payments ─────────────────────────────────────────────────────────────────
# Keep STUB=1 until provider credentials, a public HTTPS callback URL and
# production approval are all in place. The test provider moves no real money.
STUB=1
PAYMENT_PROVIDER=test
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1
ZARINPAL_CALLBACK_BASE_URL=http://localhost:8090

# ── PocketBase secrets ───────────────────────────────────────────────────────
# Optional: use a high-entropy value of exactly 32 characters when encrypted
# PocketBase settings are enabled. Leave empty to keep settings unencrypted.
PABETOOP_PB_ENCRYPTION_KEY=
