{
  "name": "pabetoop-club-client",
  "version": "0.1.0",
  "private": true,
  "description": "Client layer (tsgo / TypeScript 7 native compiler) for the FC Pabetoop academy platform.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsgo --watch",
    "build": "tsgo --outDir dist",
    "typecheck": "tsgo --noEmit --strict",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "htmx.org": "4.0.0-beta6",
    "tailwindcss": "^4.0.0"
  }
}
