{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmitOnError": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": [],
    "paths": { "@/*": ["./src/*"] },
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "composite": false
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
